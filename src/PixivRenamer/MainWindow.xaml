<Window x:Class="PixivRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PixivRenamer  ·  pixiv 插画批量重命名工具"        Width="1120" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="{DynamicResource App.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ================= 配色 ================= -->
        <SolidColorBrush x:Key="App.Background"    Color="#F4F6FA" />
        <SolidColorBrush x:Key="App.Surface"       Color="#FFFFFF" />
        <SolidColorBrush x:Key="App.Sidebar"       Color="#FFFFFF" />
        <SolidColorBrush x:Key="App.Border"        Color="#E2E8F0" />
        <SolidColorBrush x:Key="App.BorderStrong"  Color="#CBD5E1" />
        <SolidColorBrush x:Key="App.Text"          Color="#1E293B" />
        <SolidColorBrush x:Key="App.TextMuted"     Color="#64748B" />
        <SolidColorBrush x:Key="App.TextFaint"     Color="#94A3B8" />
        <SolidColorBrush x:Key="App.Accent"        Color="#4F46E5" />
        <SolidColorBrush x:Key="App.AccentDark"    Color="#4338CA" />
        <SolidColorBrush x:Key="App.AccentSoft"    Color="#EEF2FF" />
        <SolidColorBrush x:Key="App.Success"       Color="#059669" />
        <SolidColorBrush x:Key="App.Warning"       Color="#D97706" />
        <SolidColorBrush x:Key="App.WarningSoft"   Color="#FFFBEB" />
        <SolidColorBrush x:Key="App.Danger"        Color="#DC2626" />
        <SolidColorBrush x:Key="App.DangerSoft"    Color="#FEF2F2" />
        <SolidColorBrush x:Key="App.Hover"         Color="#F1F5F9" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ================= 基础控件 ================= -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
            <Setter Property="CaretBrush" Value="{DynamicResource App.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Background="Transparent"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}" />
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Background="Transparent" VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource App.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentDark}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.AccentDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D2FE" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Background" Value="{DynamicResource App.DangerSoft}" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

        <!-- 复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.BorderStrong}"
                                    BorderThickness="1.2" VerticalAlignment="Center">
                                <Path x:Name="Check" Width="10" Height="10" Stretch="Uniform"
                                      Data="M 0,5 L 4,9 L 11,1"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource App.TextFaint}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{DynamicResource App.Surface}"
                                BorderBrush="{DynamicResource App.BorderStrong}"
                                BorderThickness="1">
                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,11,0" Width="9" Height="5" Stretch="Fill"
                                  Data="M 0,0 L 4.5,5 L 9,0 Z"
                                  Fill="{DynamicResource App.TextMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                                <Border Margin="0,3,0,0" CornerRadius="8" Background="{DynamicResource App.Surface}"
                                        BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="#0F172A" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" Padding="4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条 -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片式分组 -->
        <Style x:Key="Card" TargetType="GroupBox">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Padding" Value="16,10,16,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#0F172A" />
                            </Border.Effect>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="3.5" Height="15" CornerRadius="2" Margin="0,0,9,0"
                                                Background="{DynamicResource App.Accent}" VerticalAlignment="Center" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          TextElement.FontWeight="SemiBold"
                                                          TextElement.FontSize="13.5"
                                                          TextElement.Foreground="{DynamicResource App.Text}" />
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组内小标题 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        </Style>

        <!-- 侧边导航 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 可读性更好的日志框 -->
        <Style x:Key="LogBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Background="Transparent" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource App.Surface}" Padding="6,3"
              BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="加载配置(_O)..." Click="LoadConfig_Click" />
                <MenuItem Header="保存配置(_S)..." Click="SaveConfig_Click" />
                <Separator />
                <MenuItem Header="打开报告目录(_R)" Click="OpenReportButton_Click" />
                <MenuItem Header="打开未识别文件夹(_U)" Click="OpenUnresolved_Click" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="运行自检(_T)" Click="SelfTest_Click" />
                <MenuItem Header="打开日志文件(_L)" Click="OpenLog_Click" />
                <MenuItem Header="打开缓存目录(_C)" Click="OpenCache_Click" />
                <MenuItem Header="清空日志窗口(_C)" Click="ClearLog_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="使用说明(_R)" Click="OpenReadme_Click" />
                <Separator />
                <MenuItem Header="检查更新(_U)" Click="CheckUpdate_Click" />
                <MenuItem Header="打开项目主页(_P)" Click="OpenProject_Click" />
                <MenuItem Header="反馈问题 / 建议(_I)" Click="OpenIssues_Click" />
                <Separator />
                <MenuItem Header="关于 PixivRenamer(_A)" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource App.TextFaint}"
                             VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Margin="0,9,12,0"
                             Minimum="0" Maximum="100" />
                <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="开始整理" Width="104" Height="34" Margin="4,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="StartButton_Click" IsDefault="True" />
                    <Button x:Name="CancelButton" Content="取消" Width="84" Height="34" Margin="4,0"
                            Click="CancelButton_Click" IsEnabled="False" />
                    <Button x:Name="OpenReportButton" Content="打开报告目录" Width="118" Height="34" Margin="4,0"
                            Click="OpenReportButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧导航 + 右侧内容 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource App.Sidebar}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{DynamicResource App.Accent}" Margin="0,0,10,0">
                                <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PixivRenamer" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock x:Name="SidebarVersionText" Text="WPF" FontSize="11" Foreground="{DynamicResource App.TextFaint}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Margin="18,10,18,16" FontSize="11"
                               Foreground="{DynamicResource App.TextFaint}" TextWrapping="Wrap"
                               Text="仅用于整理自己合法下载、有权处理的图片。" />

                    <ListBox x:Name="NavList" SelectionMode="Single" BorderThickness="0"
                             Background="Transparent" SelectedIndex="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="整理" FontWeight="SemiBold" />
                                <TextBlock Text="源目录 · 命名 · 分类" FontSize="11"
                                           Foreground="{DynamicResource App.TextMuted}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="pixiv / 识图" FontWeight="SemiBold" />
                                <TextBlock Text="网络 · Cookie · 识图缓冲" FontSize="11"
                                           Foreground="{DynamicResource App.TextMuted}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="任务与日志" FontWeight="SemiBold" />
                                <TextBlock Text="实时日志 · 配置 · 自检" FontSize="11"
                                           Foreground="{DynamicResource App.TextMuted}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Column="1" Margin="16,14,16,10"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        SelectedIndex="{Binding ElementName=NavList, Path=SelectedIndex, Mode=TwoWay}"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FontSize" Value="13.5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="2,0,2,0">
                                        <StackPanel>
                                            <ContentPresenter ContentSource="Header" Margin="14,8,14,9"
                                                              HorizontalAlignment="Center" />
                                            <Border x:Name="Underline" Height="3" CornerRadius="2"
                                                    Background="Transparent" Margin="8,0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource App.Accent}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource App.BorderStrong}" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ==================== 整理 ==================== -->
                <TabItem Header="整理">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <GroupBox Header="输入与输出" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="源文件夹" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SourceTextBox" Grid.Column="1" Margin="10,5" />
                                    <Button Content="浏览..." Grid.Column="2" Width="84" Margin="2,5"
                                            Click="BrowseSource_Click" />
                                    <TextBlock Grid.Row="1" Text="输出目录" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="OutputTextBox" Grid.Row="1" Grid.Column="1" Margin="10,5" />
                                    <Button Content="浏览..." Grid.Row="1" Grid.Column="2" Width="84" Margin="2,5"
                                            Click="BrowseOutput_Click" />
                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                        <CheckBox x:Name="CopyCheckBox" Content="复制到输出目录（保留原文件）" Margin="0,0,20,8" />
                                        <CheckBox x:Name="OverwriteCheckBox" Content="允许覆盖已存在文件" Margin="0,0,20,8" />
                                        <CheckBox x:Name="RecursiveCheckBox" Content="递归子目录" Margin="0,0,20,8" />
                                        <CheckBox x:Name="HiddenCheckBox" Content="包含隐藏文件" Margin="0,0,20,8" />
                                        <CheckBox x:Name="DryRunCheckBox" Content="预览模式（不修改文件，推荐）"
                                                  Margin="0,0,20,8" FontWeight="SemiBold"
                                                  Checked="DryRunCheckBox_Changed" Unchecked="DryRunCheckBox_Changed" />
                                        <CheckBox x:Name="ResumeCheckBox" Content="断点续跑（读取报告跳过）" Margin="0,0,20,8" />
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="命名与分类" Style="{StaticResource Card}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="分类方式" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,5">
                                        <ComboBox x:Name="OrganizeComboBox" Width="176" SelectedIndex="1">
                                            <ComboBoxItem Content="不分类" />
                                            <ComboBoxItem Content="按作者" />
                                            <ComboBoxItem Content="按日期" />
                                            <ComboBoxItem Content="按作者/日期" />
                                            <ComboBoxItem Content="按日期/作者" />
                                        </ComboBox>
                                        <CheckBox x:Name="SplitR18CheckBox" Content="R-18 单独文件夹" Margin="20,0,0,0"
                                                  VerticalAlignment="Center" />
                                        <CheckBox x:Name="MoveUnresolvedCheckBox" Margin="20,0,0,0"
                                                  Content="未识别文件单独归类"
                                                  ToolTip="正式执行时，把无法识别作者/标题的图片按原名移入下面的文件夹，便于之后再查；原名不变，报告里记录原因。" />
                                        <TextBox x:Name="UnresolvedFolderTextBox" Width="120" Margin="10,0,0,0"
                                                 ToolTip="未识别文件归档文件夹名（默认：未识别）" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="命名模板" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TemplateTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                             Margin="10,5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,6"
                                               Style="{StaticResource Hint}"
                                               Text="可用变量：{author}  {title}  {pid}  {page}  {date}  {tags}  {userid}  {account}  {r18}" />
                                    <TextBlock Grid.Row="3" Text="未知占位" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Margin="10,5">
                                        <TextBlock Text="未知作者" VerticalAlignment="Center" />
                                        <TextBox x:Name="UnknownAuthorTextBox" Width="150" Margin="8,0,0,0" />
                                        <TextBlock Text="未知标题" VerticalAlignment="Center" Margin="18,0,0,0" />
                                        <TextBox x:Name="UnknownTitleTextBox" Width="150" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="报告与日志" Style="{StaticResource Card}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="报告文件" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ReportTextBox" Grid.Column="1" Margin="10,5" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,2,0,0">
                                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="留空 = &lt;源目录&gt;\_pixiv_rename_report.csv" />
                                        <CheckBox x:Name="LogToFileCheckBox" Content="写入日志文件" Margin="24,0,0,0" />
                                        <CheckBox x:Name="VerboseCheckBox" Content="详细日志" Margin="18,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,12,0,0">
                                        <Button Content="打开报告目录" Width="118" Click="OpenReportButton_Click" />
                                        <Button Content="打开未识别文件夹" Width="146" Margin="10,0,0,0"
                                                Click="OpenUnresolved_Click"
                                                ToolTip="打开「未识别」文件夹：确认哪些图片没认出作者/标题" />
                                        <Button Content="未识别清单" Width="104" Margin="10,0,0,0"
                                                Click="OpenUnresolvedList_Click"
                                                ToolTip="打开 _unresolved.txt：按原因分类列出所有未识别文件" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <Border CornerRadius="10" Background="{DynamicResource App.WarningSoft}"
                                    BorderBrush="#FDE68A" BorderThickness="1" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource App.Warning}" />
                                    <TextBlock Style="{StaticResource Hint}" Foreground="#92400E"
                                               Text="安全建议：第一次先勾选「预览模式」跑一遍，确认日志与报告里的命名、分类结果符合预期，再取消预览正式执行（会二次确认）。" />
                                </StackPanel>
                            </Border>

                            <GroupBox Header="权限、更新与项目信息" Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock x:Name="ElevatedStateText" Text="当前：—" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Margin="0,0,16,8" />
                                        <Button x:Name="ElevateNowButton" Content="以管理员重启" Width="136" Margin="0,0,16,8"
                                                Click="ElevateNow_Click"
                                                ToolTip="立即以管理员身份重新启动本程序（会弹 UAC 确认框）" />
                                        <CheckBox x:Name="RunAsAdminCheckBox" Content="默认以管理员身份启动" Margin="0,0,16,8"
                                                  VerticalAlignment="Center"
                                                  Checked="RunAsAdminCheckBox_Changed" Unchecked="RunAsAdminCheckBox_Changed"
                                                  ToolTip="勾选后，下次启动程序会自动请求管理员权限（弹 UAC）。" />
                                        <TextBlock Text="（保存配置后生效）" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="CheckUpdateOnStartupCheckBox" Content="启动时自动检查更新"
                                                  Margin="0,0,16,8" VerticalAlignment="Center"
                                                  ToolTip="启动后静默查询 GitHub 上的最新版本；发现新版本才会弹窗提示。" />
                                        <Button Content="检查更新" Width="96" Margin="0,0,16,8" Click="CheckUpdate_Click" />
                                        <Button Content="项目主页" Width="96" Margin="0,0,16,8" Click="OpenProject_Click" />
                                        <Button Content="反馈问题" Width="96" Margin="0,0,0,8" Click="OpenIssues_Click" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="为什么默认要管理员：本程序需要打开浏览器、配合浏览器读取/复制 Cookie；当浏览器是「以管理员身份运行」时，普通权限的程序无法与它交互，所以默认以管理员身份启动。命令行（--cli）与自检（--selftest）不会自动提权，方便脚本调用；界面模式可用 --no-elevate 跳过本次提权。" />
                                    <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource App.Border}"
                                            BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}">
                                                <Run Text="项目主页：" />
                                                <Hyperlink NavigateUri="https://github.com/CYHY-MK/PixivRenamer"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Foreground="{DynamicResource App.Accent}">github.com/CYHY-MK/PixivRenamer</Hyperlink>
                                                <Run Text="　｜　作者：" />
                                                <Hyperlink NavigateUri="https://github.com/CYHY-MK"
                                                           RequestNavigate="Hyperlink_RequestNavigate"
                                                           Foreground="{DynamicResource App.Accent}">CYHY-MK</Hyperlink>
                                                <Run Text="　｜　许可：MIT" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="声明：本工具仅用于整理你自己合法下载、自己有权处理的图片。请遵守 pixiv、SauceNAO、ascii2d 等网站的服务条款，控制请求频率，不要用于大规模爬取、商业用途或任何侵犯版权的行为。使用产生的一切后果由使用者自行承担。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== pixiv / 识图 ==================== -->
                <TabItem Header="pixiv / 识图">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <GroupBox Header="pixiv 查询" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Cookie" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                        <TextBox x:Name="CookieTextBox" Width="480"
                                                 ToolTip="查询 R-18 / 受限作品时必填；浏览器 F12 -> 网络 -> 请求标头里的 Cookie 整行" />
                                        <TextBlock Text="（查询 R-18 必填）" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="账号 / 密码" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                        <TextBox x:Name="PixivAccountTextBox" Width="180"
                                                 ToolTip="pixiv 登录邮箱或 pixiv ID" />
                                        <PasswordBox x:Name="PixivPasswordBox" Width="180" Margin="8,0,0,0" />
                                        <Button Content="自动获取 Cookie" Width="150" Margin="8,0,0,0"
                                                Click="AutoLogin_Click" />
                                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Hyperlink NavigateUri="https://accounts.pixiv.net/login"
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Foreground="{DynamicResource App.Accent}">打开 pixiv 登录页</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="网络与代理" Style="{StaticResource FieldLabel}" />
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="10,5">
                                        <ComboBox x:Name="ProxyModeComboBox" Width="176" Margin="0,0,10,6"
                                                  SelectionChanged="ProxyMode_Changed"
                                                  ToolTip="自动侦测：自动找本机 Clash / v2rayN 等监听的代理端口，最适合便携版发给别人使用">
                                            <ComboBoxItem Content="自动侦测（推荐）" />
                                            <ComboBoxItem Content="手动指定代理" />
                                            <ComboBoxItem Content="使用系统代理" />
                                            <ComboBoxItem Content="直连（不用代理）" />
                                        </ComboBox>
                                        <TextBox x:Name="ProxyTextBox" Width="210" Margin="0,0,10,6"
                                                 ToolTip="手动指定模式才需要填；例如 127.0.0.1:7897（Clash Verge 默认）或 127.0.0.1:7890（Clash for Windows 默认）" />
                                        <Button Content="检测本地代理" Width="120" Margin="0,0,10,6"
                                                Click="DetectProxy_Click"
                                                ToolTip="扫描本机监听的代理端口（Clash、v2rayN、Sing-box…）并逐个验证，列出哪个可用" />
                                        <Button Content="测试网络" Width="92" Margin="0,0,18,6" Click="TestNetwork_Click" />
                                    </WrapPanel>
                                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="10,4,0,0">
                                        <TextBlock Text="线程 / 间隔 / 超时 / 重试" VerticalAlignment="Center" Margin="0,0,8,6" />
                                        <TextBox x:Name="ThreadsTextBox" Width="54" Margin="0,0,8,6"
                                                 ToolTip="pixiv 元数据查询线程数，建议 1~4" />
                                        <TextBox x:Name="DelayTextBox" Width="76" Margin="0,0,8,6"
                                                 ToolTip="pixiv 请求间隔（毫秒）" />
                                        <TextBox x:Name="TimeoutTextBox" Width="76" Margin="0,0,8,6"
                                                 ToolTip="超时（毫秒）" />
                                        <TextBox x:Name="RetriesTextBox" Width="54" Margin="0,0,8,6"
                                                 ToolTip="HTTP 重试次数" />
                                    </WrapPanel>
                                    <WrapPanel Grid.Row="4" Grid.Column="1" Margin="10,4,0,0">
                                        <CheckBox x:Name="HtmlFallbackCheckBox" Content="AJAX 失败时尝试解析 HTML 页"
                                                  Margin="0,0,20,8" />
                                        <CheckBox x:Name="CacheCheckBox" Content="启用本地查询缓存" Margin="0,0,20,8" />
                                        <TextBlock Text="缓存天数" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox x:Name="CacheDaysTextBox" Width="58" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ProxyHintText" Grid.Row="5" Grid.Column="1" Margin="10,4,0,0"
                                               Style="{StaticResource Hint}"
                                               Text="自动侦测会依次尝试：配置文件里读到的 Clash 端口 → 系统代理设置 → 常见本地端口；被限流或连不上时会写诊断报告到 exe 目录的 error-reports。" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="识图回退与请求缓冲" Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ReverseCheckBox"
                                              Content="无 PID / 缺少作者或标题时，用 SauceNAO / ascii2d 识图辅助查询"
                                              Margin="0,0,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="服务顺序" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                            <TextBox x:Name="OrderTextBox" Width="170"
                                                     ToolTip="按顺序尝试，命中 pixiv 链接即停止；例如 saucenao,ascii2d" />
                                            <TextBlock Text="SauceNAO API Key" VerticalAlignment="Center" Margin="18,0,8,0" />
                                            <TextBox x:Name="SauceKeyTextBox" Width="360" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="判定阈值" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                            <TextBlock Text="相似度下限" VerticalAlignment="Center" />
                                            <TextBox x:Name="MinSimTextBox" Width="66" Margin="8,0,0,0" />
                                            <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0,16,0" />
                                            <TextBlock Text="上传体积上限" VerticalAlignment="Center" />
                                            <TextBox x:Name="MaxKbTextBox" Width="76" Margin="8,0,0,0" />
                                            <TextBlock Text="KB（超过会先压缩再上传）" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,6">
                                            <CheckBox x:Name="VerifyByHashCheckBox"
                                                      Content="中置信度结果用感知哈希复核（推荐）"
                                                      ToolTip="置信度低于 85 的候选会下载来源缩略图做 dHash 比对，只有对得上才采纳，可显著减少同角色/相似构图造成的误命名。" />
                                            <TextBlock Text="距离上限" VerticalAlignment="Center" Margin="18,0,6,0" />
                                            <TextBox x:Name="HashDistanceTextBox" Width="58" />
                                            <TextBlock Text="/64" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="GroupByHashCheckBox" Margin="0,10,0,0"
                                              Content="近似重复图只查一次识图（按 dHash 合并同一张图的不同分辨率 / 重存版本）" />
                                    <CheckBox x:Name="ReverseWhenPixivDownCheckBox" Margin="0,8,0,0"
                                              Content="pixiv 不可达时仍尝试识图（识图接口与 pixiv 无关）" />

                                    <Border CornerRadius="9" Background="#F8FAFC" BorderBrush="{DynamicResource App.Border}"
                                            BorderThickness="1" Padding="14,12" Margin="0,14,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Width="3.5" Height="14" CornerRadius="2" Margin="0,0,8,0"
                                                        Background="{DynamicResource App.Success}" VerticalAlignment="Center" />
                                                <TextBlock Text="请求缓冲（限流保护）" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Text="· 识图请求排队送出，被 429/503 限流时全局冷却，避免越打越被拦" />
                                            </StackPanel>
                                            <WrapPanel>
                                                <CheckBox x:Name="ReverseQueueCheckBox" Content="启用识图请求排队缓冲"
                                                          Margin="0,0,22,8" FontWeight="SemiBold"
                                                          ToolTip="关闭后识图按线程数直接并发请求，速度快但更容易触发限流。" />
                                                <TextBlock Text="识图并发" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <TextBox x:Name="ReverseConcurrencyTextBox" Width="58" Margin="0,0,22,8"
                                                         ToolTip="同时进行的识图请求数，1 = 完全串行（最稳，推荐）" />
                                                <TextBlock Text="冷却时间" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <TextBox x:Name="ReverseCooldownTextBox" Width="80" Margin="0,0,4,8"
                                                         ToolTip="被限流后的基础冷却（毫秒），连续被限流会指数增长" />
                                                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="0,0,22,8" />
                                                <TextBlock Text="失败重试" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <TextBox x:Name="ReverseRetriesTextBox" Width="58" Margin="0,0,22,8"
                                                         ToolTip="识图没有结果时的重试次数（0 = 不重试）" />
                                                <TextBlock Text="单图超时" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <TextBox x:Name="ReverseTimeoutTextBox" Width="84" Margin="0,0,4,8"
                                                         ToolTip="单个文件识图的等待上限（毫秒），包含冷却等待" />
                                                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="0,0,0,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Hint}">
                                        <Run Text="SauceNAO API Key 获取：" />
                                        <Hyperlink NavigateUri="https://saucenao.com/user.php?page=account"
                                                   RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{DynamicResource App.Accent}">saucenao.com/user.php?page=account</Hyperlink>
                                        <Run Text="　｜　 ascii2d：" />
                                        <Hyperlink NavigateUri="https://ascii2d.net/"
                                                   RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{DynamicResource App.Accent}">ascii2d.net</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="SauceNAO 现已要求填写 API Key（匿名调用会被直接拒绝）；ascii2d 可能需要能通过 Cloudflare 校验的网络。识图结果仅作辅助，请先用预览模式检查。" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== 任务与日志 ==================== -->
                <TabItem Header="任务与日志">
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="300" />
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border CornerRadius="10" Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    Padding="14,11" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="任务记录" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                    <TextBlock x:Name="StatTasksText" Text="—" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    Padding="14,11" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="已识别" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                    <TextBlock x:Name="StatResolvedText" Text="—" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Success}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    Padding="14,11" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="未识别" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                    <TextBlock x:Name="StatUnresolvedText" Text="—" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Warning}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    Padding="14,11" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="失败" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                    <TextBlock x:Name="StatFailedText" Text="—" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Danger}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LogTextBox" Style="{StaticResource LogBox}" VerticalAlignment="Stretch" />
                            <Border Grid.Column="0" CornerRadius="10" Background="Transparent" IsHitTestVisible="False">
                                <TextBlock x:Name="LogEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextFaint}"
                                           Text="日志会显示在这里：扫描、pixiv 查询、识图进度与限流冷却。" />
                            </Border>

                            <Border Grid.Column="1" Width="266" Margin="12,0,0,0" CornerRadius="10"
                                    Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Padding="14,12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="最近任务" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="保存配置" Margin="0,0,0,8" Click="SaveConfig_Click" />
                                        <Button Content="重新加载配置" Margin="0,0,0,8" Click="LoadConfig_Click" />
                                        <Button Content="运行自检" Margin="0,0,0,8" Click="SelfTest_Click" />
                                        <Button Content="打开日志文件" Margin="0,0,0,8" Click="OpenLog_Click" />
                                        <Button Content="清空日志" Style="{StaticResource DangerButton}"
                                                Click="ClearLog_Click" />
                                    </StackPanel>
                                    <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border CornerRadius="7" Background="#F8FAFC"
                                                                    BorderBrush="{DynamicResource App.Border}"
                                                                    BorderThickness="1" Padding="10,8">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
